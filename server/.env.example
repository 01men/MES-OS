# JWT：生产环境必须替换为高强度随机值
MES_JWT_SECRET=change-me-in-production

# 浏览器可访问的 MES 根地址；必须与钉钉应用回调域名一致
MES_PUBLIC_ORIGIN=http://127.0.0.1:5173

# 钉钉 OAuth2（企业内部应用）
MES_DINGTALK_CLIENT_ID=
MES_DINGTALK_CLIENT_SECRET=

# 管理界面保存敏感配置时使用的加密主密钥；生产环境必须独立随机生成
MES_CONFIG_ENCRYPTION_KEY=change-me-to-a-random-32-byte-secret

# 仅在反向代理正确覆盖 Forwarded Headers 时启用
MES_TRUST_PROXY=0

# External system API keys. Format: client-name=api-key,client-2=api-key-2
# Leave empty to disable every /api/open/v1 endpoint.
MES_OPEN_API_KEYS=u8=replace-with-a-long-random-api-key
