{
  "name": "mes-wms-server",
  "version": "0.1.0",
  "private": true,
  "description": "MES WMS module backend (NestJS 10 + TypeORM sqljs)",
  "scripts": {
    "start:dev": "ts-node --transpile-only src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "seed": "ts-node --transpile-only src/seed.ts",
    "seed:demo": "ts-node --transpile-only src/seed-demo.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sql.js": "^1.12.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@swc/core": "^1.7.42",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.4"
  }
}
